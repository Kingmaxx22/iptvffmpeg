{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluent IPTV",
  "version": "0.1.0",
  "identifier": "com.fluentiptv.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Fluent IPTV",
        "width": 1360,
        "height": 860,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "focus": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}