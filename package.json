{
  "name": "fluent-iptv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fluent IPTV - a Tauri + ffmpeg live TV player for the iptv-org playlist",
  "scripts": {
    "dev": "vite",
    "build": "npm run ffmpeg:fetch && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "dev:server": "cargo run --manifest-path src-tauri/Cargo.toml --bin media-server",
    "app:dev": "npm run ffmpeg:fetch && tauri dev",
    "app:build": "npm run ffmpeg:fetch && tauri build",
"app:portable": "npm run ffmpeg:fetch && tauri build --no-bundle && node scripts/make-portable.mjs --zip",
    "stop:orphans": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-orphans.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "mpegts.js": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
